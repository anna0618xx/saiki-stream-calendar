{
  "manifest_version": 3,
  "name": "佐伯配信手帳｜PCスクショ回収（試験版）",
  "version": "0.1.3",
  "description": "手動操作でYouTube配信のスクショ回収（最大10件）と配信時間の確認を補助します。",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://anna0618xx.github.io/saiki-stream-calendar/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "佐伯配信手帳 スクショ回収"
  },
  "minimum_chrome_version": "116"
}
